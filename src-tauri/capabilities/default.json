{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The launcher window: its own commands, folder/file pickers, opening web links.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "dialog:allow-open",
    "dialog:allow-ask",
    "dialog:allow-message",
    "opener:default"
  ]
}
