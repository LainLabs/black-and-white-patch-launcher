{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Black & White Launcher",
  "version": "0.1.2",
  "identifier": "org.bwdecomp.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist-web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Black & White Launcher",
        "width": 1120,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#0d0b09"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Black & White patch contributors",
    "shortDescription": "Installs, configures and starts the Black & White patch",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "",
        "displayLanguageSelector": false
      }
    }
  }
}
